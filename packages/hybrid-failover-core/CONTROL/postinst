#!/bin/sh
# hybrid-failover-core postinst
mkdir -p /etc/hybrid-failover/pending
chmod 755 /etc/hybrid-failover /etc/hybrid-failover/pending
# Legacy layout: monolithic binary in /usr/bin (current core is /usr/sbin/hybrid-failover).
if [ -x /usr/sbin/hybrid-failover ] && [ -f /usr/bin/hybrid-failover ]; then
	rm -f /usr/bin/hybrid-failover
fi
[ -x /usr/sbin/hybrid-failover ] && /usr/sbin/hybrid-failover migrate 2>/dev/null || true
# Apply the UDP socket buffer tuning immediately; /etc/init.d/sysctl also
# picks it up on every future boot.
[ -f /etc/sysctl.d/20-hybrid-failover.conf ] && sysctl -p /etc/sysctl.d/20-hybrid-failover.conf >/dev/null 2>&1 || true
# An upgrade replaces the binary under a running engine, which keeps the old
# code in memory until it is restarted. Restart it, but only when it was
# running, so that an upgrade never starts what the user had stopped.
if [ -z "${IPKG_INSTROOT}" ] && [ "${PKG_UPGRADE}" = "1" ] && /etc/init.d/hybrid-failover running >/dev/null 2>&1; then
	/etc/init.d/hybrid-failover restart >/dev/null 2>&1 || true
fi
exit 0
