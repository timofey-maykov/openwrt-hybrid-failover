#!/bin/sh
# luci-app-hybrid-failover postinst
# rpcd loads /usr/share/rpcd/ucode/* only at start
[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd restart >/dev/null 2>&1
rm -rf /tmp/luci-modulecache/* /tmp/luci-indexcache/* 2>/dev/null || true
[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd restart >/dev/null 2>&1
exit 0
