'use strict';

import { popen, access, readfile } from 'fs';

const BIN = '/usr/sbin/hybrid-failover';

function shellquote(s) {
	return `'${replace(s, "'", "'\\''")}'`;
}

function run_cli(args) {
	if (access(BIN) != true)
		return { ok: false, code: 127, output: 'hybrid-failover binary not found' };

	let cmd = join(' ', map(args, (a) => shellquote(a)));
	cmd = `${shellquote(BIN)} ${cmd}`;

	let fd = popen(`(${cmd}) 2>&1; echo __HF_EXIT:$?`, 'r');
	let all = fd ? fd.read('all') : '';
	if (fd)
		fd.close();

	let m = match(all, /__HF_EXIT:(\d+)\s*$/);
	let code = m ? int(m[1]) : 1;
	let output = trim(replace(all, /__HF_EXIT:\d+\s*$/, ''));

	return { ok: code == 0, code, output };
}

function run_rpc(method) {
	return run_cli(['rpc', method]);
}

function parse_json_output(res) {
	if (!length(res.output))
		return { ok: res.ok, data: null };

	try {
		// Keep CLI exit status: failed checks still return structured JSON.
		return { ok: res.ok, data: json(res.output) };
	}
	catch (err) {
		return { ok: res.ok, output: res.output };
	}
}

function method_call(rpc_name, cli_args) {
	return {
		call: function() {
			let res = rpc_name ? run_rpc(rpc_name) : run_cli(cli_args);
			let parsed = parse_json_output(res);

			if (parsed.data != null)
				return { ok: parsed.ok, data: parsed.data };

			if (parsed.output != null)
				return { ok: parsed.ok, output: parsed.output };

			if (parsed.ok && parsed.data == null && !length(res.output))
				return { ok: true, data: [] };

			return { ok: res.ok, code: res.code, output: res.output };
		}
	};
}

function method_switch_proxy() {
	return {
		args: {
			section: '',
			outbound: '',
		},
		call: function(req) {
			let section = req.args.section ?? '';
			let outbound = req.args.outbound ?? '';
			let res = run_cli(['rpc', 'SwitchProxy', section, outbound]);
			let parsed = parse_json_output(res);
			if (parsed.data != null)
				return { ok: parsed.ok, data: parsed.data };
			if (parsed.output != null)
				return { ok: parsed.ok, output: parsed.output };
			return { ok: res.ok, code: res.code, output: res.output };
		}
	};
}

function method_rpc_args(method, keys) {
	let arg_policy = {};
	for (let i = 0; i < length(keys); i++)
		arg_policy[keys[i]] = '';

	return {
		args: arg_policy,
		call: function(req) {
			let args = ['rpc', method];
			for (let i = 0; i < length(keys); i++) {
				let k = keys[i];
				let v = req.args[k] ?? '';
				if (v != null && v != '')
					push(args, v);
			}
			let res = run_cli(args);
			let parsed = parse_json_output(res);
			if (parsed.data != null)
				return { ok: parsed.ok, data: parsed.data };
			if (parsed.output != null)
				return { ok: parsed.ok, output: parsed.output };
			return { ok: res.ok, code: res.code, output: res.output };
		}
	};
}

function method_decode_uri() {
	return {
		args: {
			uri: '',
		},
		call: function(req) {
			let uri = req.args.uri ?? '';
			let res = run_cli(['rpc', 'DecodeURI', uri]);
			let parsed = parse_json_output(res);
			if (parsed.data != null)
				return { ok: parsed.ok, data: parsed.data };
			if (parsed.output != null)
				return { ok: parsed.ok, output: parsed.output };
			return { ok: res.ok, code: res.code, output: res.output };
		}
	};
}

function method_apply() {
	return {
		call: function() {
			let res = run_cli(['apply']);
			return { ok: res.ok, code: res.code, output: res.output };
		}
	};
}

function run_ubus(object, method, args) {
	let cmd = sprintf('ubus call %s %s %s 2>/dev/null; echo __HF_EXIT:$?',
		shellquote(object), shellquote(method), args ?? "'{}'");
	let fd = popen(`(${cmd})`, 'r');
	let all = fd ? fd.read('all') : '';
	if (fd)
		fd.close();
	let m = match(all, /__HF_EXIT:(\d+)\s*$/);
	let code = m ? int(m[1]) : 1;
	let output = trim(replace(all, /__HF_EXIT:\d+\s*$/, ''));
	return { ok: code == 0, output: output };
}

function format_mac(mac) {
	if (!mac)
		return '';
	if (match(mac, /^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$/))
		return lc(mac);
	let s = lc(replace(mac, /[^0-9a-fA-F]/g, ''));
	if (length(s) != 12)
		return mac;
	return sprintf('%s:%s:%s:%s:%s:%s',
		substr(s, 0, 2), substr(s, 2, 2), substr(s, 4, 2),
		substr(s, 6, 2), substr(s, 8, 2), substr(s, 10, 2));
}

function normalize_lease_entry(L) {
	return {
		ip: L.ipaddr || L.ip || L.address || '',
		hostname: L.hostname || '',
		mac: format_mac(L.macaddr || L.mac || ''),
		expires: (L.expires != null) ? L.expires : ((L.valid != null) ? L.valid : L.leasetime)
	};
}

function push_leases(out, list) {
	if (type(list) != 'array')
		return;
	for (let i = 0; i < length(list); i++)
		push(out, normalize_lease_entry(list[i]));
}

function leases_from_odhcpd(data) {
	let leases = [];
	if (type(data) != 'object' || type(data) == 'array')
		return leases;
	for (let iface in data)
		push_leases(leases, data[iface]);
	return leases;
}

function dhcp_leasefile_paths() {
	let paths = [];
	let seen = {};

	let fd = popen("uci -q show dhcp 2>/dev/null | grep 'leasefile=' | grep -v odhcpd", 'r');
	if (fd) {
		for (let line = fd.read('line'); length(line); line = fd.read('line')) {
			let m = match(trim(line), /leasefile='([^']+)'$/);
			if (m && !seen[m[1]]) {
				seen[m[1]] = true;
				push(paths, m[1]);
			}
		}
		fd.close();
	}

	if (!length(paths) && access('/tmp/dhcp.leases') == true)
		push(paths, '/tmp/dhcp.leases');

	return paths;
}

function parse_dnsmasq_leases(path, now) {
	let leases = [];
	let content = readfile(path);
	if (!content)
		return leases;

	for (let line in split(content, /\n/)) {
		line = trim(line);
		if (!length(line))
			continue;

		let parts = split(line, ' ');
		if (length(parts) < 4)
			continue;

		let exp = int(parts[0]);
		let hostname = parts[3];
		if (hostname == '*')
			hostname = '';

		push(leases, normalize_lease_entry({
			ipaddr: parts[2],
			macaddr: parts[1],
			hostname: hostname,
			expires: (exp > now) ? exp - now : 0
		}));
	}

	return leases;
}

function method_dhcp_leases() {
	return {
		call: function() {
			let leases = [];
			let source = '';
			let now = time();

			for (let path in dhcp_leasefile_paths()) {
				let parsed = parse_dnsmasq_leases(path, now);
				if (length(parsed)) {
					leases = parsed;
					source = 'dnsmasq';
					break;
				}
			}

			if (!length(leases)) {
				let odhcp = run_ubus('dhcp', 'ipv4leases', "'{}'");
				if (odhcp.ok && length(odhcp.output)) {
					try {
						leases = leases_from_odhcpd(json(odhcp.output));
						if (length(leases))
							source = 'odhcpd';
					}
					catch (err) {
						return { ok: false, output: odhcp.output || 'dhcp ipv4leases parse error' };
					}
				}
			}

			return { ok: true, data: { leases: leases, source: source } };
		}
	};
}

	return {
	'hybrid-failover': {
		status: method_call('Status', null),
		health: method_call('Health', null),
		history: method_call('History', null),
		export_history: method_call('ExportHistory', null),
		validate: method_call('Validate', null),
		check_nft: method_call('CheckNft', null),
		check_fakeip: method_call('CheckFakeip', null),
		global_check: method_call('GlobalCheck', null),
		decode_uri: method_decode_uri(),
		switch_proxy: method_switch_proxy(),
		backup_uci: method_call('BackupUCI', null),
		restore_uci: method_rpc_args('RestoreUCI', ['path']),
		duplicate_section: method_rpc_args('DuplicateSection', ['from', 'to']),
		apply: method_apply(),
		reload: method_call(null, ['reload']),
		list_update: method_call('ListUpdate', null),
		subscription_refresh: method_call('SubscriptionRefresh', null),
		list_clients: method_call('ListClients', null),
		delay_history: method_call('DelayHistory', null),
		backup_download: method_call('BackupDownload', null),
		metrics: method_call('Metrics', null),
		dhcp_leases: method_dhcp_leases(),
		pending_validate: method_call('PendingValidate', null),
		pending_capture: method_call('CapturePending', null),
		pending_apply: method_call('PendingApply', null),
		pending_rollback: method_call('PendingRollback', null),
	}
};
