#!/bin/sh /etc/rc.common
# Hybrid Failover Core: routing + policy monitor (procd)

START=99
STOP=10
USE_PROCD=1

boot() {
	# UCI may still point dnsmasq at 127.0.0.42 from the previous run while the
	# engine is not up yet. Restore upstream DNS first so LAN keeps working
	# during the wait; start re-points after the engine listens.
	hf_dns_boot_safe

	# tproxy needs br-lan and a working nft backend; wait briefly after cold boot.
	local n=0
	while [ "$n" -lt 45 ]; do
		if [ -d /sys/class/net/br-lan ] && nft list tables >/dev/null 2>&1; then
			break
		fi
		n=$((n + 1))
		sleep 1
	done
	if [ "$n" -ge 45 ]; then
		logger -t hybrid-failover "boot: br-lan or nft not ready after ${n}s; starting anyway"
	fi
	# Must call start: overriding boot() replaces rc.common's boot→start.
	start
}

# hf_dns_boot_safe restores dhcp if left on 127.0.0.42 from a previous run.
# At boot the engine is not listening yet, so LAN would have no DNS until start.
hf_dns_boot_safe() {
	local server
	server="$(uci -q get dhcp.@dnsmasq[0].server 2>/dev/null)"
	case "$server" in
	*127.0.0.42*)
		logger -t hybrid-failover "boot: restoring dnsmasq before start"
		/usr/sbin/hybrid-failover stop >/dev/null 2>&1 || true
		;;
	esac
}

hf_start_once() {
	local n=0 max="${HF_START_RETRIES:-5}"
	while [ "$n" -lt "$max" ]; do
		if /usr/sbin/hybrid-failover start; then
			return 0
		fi
		n=$((n + 1))
		logger -t hybrid-failover "start attempt ${n}/${max} failed"
		[ "$n" -lt "$max" ] && sleep 2
	done
	return 1
}

start_service() {
	if ! hf_start_once; then
		logger -t hybrid-failover "start failed; monitor not started"
		# Avoid leaving LAN without DNS (dhcp.server=127.0.0.42 from a prior run).
		/usr/sbin/hybrid-failover stop >/dev/null 2>&1 || true
		return 1
	fi

	lan="$(uci -q get network.lan.ipaddr 2>/dev/null)"
	if [ -n "$lan" ]; then
		printf 'search lan\nnameserver %s\n' "$lan" > /tmp/resolv.conf
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/hybrid-failover monitor
	procd_set_param env GOMEMLIMIT=64MiB
	procd_set_param env GOGC=50
	procd_set_param env GOMAXPROCS=1
	procd_set_param env GODEBUG=madvdontneed=1
	procd_set_param term_timeout 10
	procd_set_param respawn 3600 15 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger hybrid-failover
	procd_add_interface_trigger "interface.*" /etc/init.d/hybrid-failover reload
}

stop_service() {
	/usr/sbin/hybrid-failover stop
}

reload_service() {
	/usr/sbin/hybrid-failover reload
}

status() {
	/usr/sbin/hybrid-failover status
}
