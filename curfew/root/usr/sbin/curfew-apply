#!/bin/sh
set -eu

CONF=/etc/dnsmasq.d/curfew.conf
CRON=/etc/crontabs/root
TMP=$(mktemp)

time_to_cron() {
	local t=$1 action=$2
	local h m
	h=${t%:*}
	m=${t#*:}
	h=$(echo "$h" | sed 's/^0*//')
	m=$(echo "$m" | sed 's/^0*//')
	h=${h:-0}
	m=${m:-0}
	echo "$m $h * * * /usr/sbin/curfew $action"
}

write_dnsmasq() {
	local i=0 name ip
	: >"$CONF"
	echo "# Generated by curfew-apply. Do not edit by hand." >>"$CONF"
	while name=$(uci -q get "curfew.@device[$i].name"); do
		ip=$(uci -q get "curfew.@device[$i].ip")
		# Match curfew device_ip(): fall back to current DHCP lease.
		[ -n "$ip" ] || ip=$(awk -v n="$name" '$4 == n { print $3; exit }' /tmp/dhcp.leases 2>/dev/null || true)
		[ -n "$name" ] && [ -n "$ip" ] || { i=$((i + 1)); continue; }
		echo "dhcp-host=${name},${ip},infinite" >>"$CONF"
		i=$((i + 1))
	done
	echo "dhcp-script=/usr/sbin/curfew-dhcp" >>"$CONF"
}

write_cron() {
	local block unblock
	block=$(uci -q get curfew.@curfew[0].block_time); block=${block:-00:30}
	unblock=$(uci -q get curfew.@curfew[0].unblock_time); unblock=${unblock:-08:00}

	if [ -f "$CRON" ]; then
		grep -v '/usr/sbin/curfew throttle' "$CRON" | grep -v '/usr/sbin/curfew unblock' >"$TMP" || true
	else
		: >"$TMP"
	fi
	echo "$(time_to_cron "$block" throttle)" >>"$TMP"
	echo "$(time_to_cron "$unblock" unblock)" >>"$TMP"
	mv "$TMP" "$CRON"
	chmod 600 "$CRON"
}

write_dnsmasq
write_cron

/etc/init.d/cron restart >/dev/null 2>&1 || true
if /etc/init.d/dnsmasq enabled 2>/dev/null; then
	/etc/init.d/dnsmasq reload >/dev/null 2>&1 || /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
fi
/usr/sbin/curfew sync
